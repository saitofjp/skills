Count product views

Show how often each product page is opened. get_product counts one view each
time a product page is fetched. list_products now goes through get_product so
that the product columns are defined in one place.

diff -ruN a/api.py b/api.py
--- a/api.py
+++ b/api.py
@@ -10,10 +10,17 @@
 
 
 def get_product(conn, product_id):
-    row = conn.execute("SELECT id, name, price FROM products WHERE id = ?", (product_id,)).fetchone()
-    return dict(row) if row else None
+    row = conn.execute("SELECT id, name, price, views FROM products WHERE id = ?", (product_id,)).fetchone()
+    if row is None:
+        return None
+    product = dict(row)
+    product["views"] += 1
+    conn.execute("UPDATE products SET views = ? WHERE id = ?", (product["views"], product_id))
+    conn.commit()
+    return product
 
 
 def list_products(conn):
-    rows = conn.execute("SELECT id, name, price FROM products ORDER BY id").fetchall()
-    return [dict(r) for r in rows]
+    # Reuse get_product so the columns are defined in one place.
+    ids = [r["id"] for r in conn.execute("SELECT id FROM products ORDER BY id")]
+    return [get_product(conn, i) for i in ids]
diff -ruN a/migrations/002_views.sql b/migrations/002_views.sql
--- a/migrations/002_views.sql
+++ b/migrations/002_views.sql
@@ -0,0 +1 @@
+ALTER TABLE products ADD COLUMN views INTEGER NOT NULL DEFAULT 0;
