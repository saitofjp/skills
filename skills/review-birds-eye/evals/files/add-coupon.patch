--- a/migrations/001_init.sql
+++ b/migrations/001_init.sql
@@ -1,2 +1,2 @@
 CREATE TABLE products (id INTEGER PRIMARY KEY, name TEXT NOT NULL, price INTEGER NOT NULL);
-CREATE TABLE orders (id INTEGER PRIMARY KEY, product_id INTEGER NOT NULL REFERENCES products(id), qty INTEGER NOT NULL);
