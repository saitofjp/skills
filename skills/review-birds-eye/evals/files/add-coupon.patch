diff -ruN a/orders.py b/orders.py
--- a/orders.py
+++ b/orders.py
@@ -1,6 +1,6 @@
 def insert_order(conn, data):
     cur = conn.execute(
-        "INSERT INTO orders (product_id, qty) VALUES (?, ?)",
