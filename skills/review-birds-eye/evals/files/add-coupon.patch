Add coupon codes to orders

An order can carry a coupon code. Only known codes are accepted, so that a
discount is never given for a code we did not issue. The code is stored on the
order; the partner CSV gets an optional coupon column.

diff -ruN a/api.py b/api.py
--- a/api.py
+++ b/api.py
@@ -1,9 +1,15 @@
 from orders import insert_order
-from validation import validate_order
+from validation import InvalidOrder, validate_order
+
+
+COUPONS = {"WELCOME10": 10, "VIP20": 20}
 
 
 def create_order(conn, data):
     validate_order(conn, data)
+    coupon = data.get("coupon")
+    if coupon is not None and coupon not in COUPONS:
+        raise InvalidOrder("unknown coupon")
     order_id = insert_order(conn, data)
     conn.commit()
     return order_id
diff -ruN a/import_orders.py b/import_orders.py
